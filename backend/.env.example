# Copy to backend/.env. Every value is optional: with none set, HoldFast runs fully on fallbacks
# (heuristic agents, simulated SIM- escrow, in-memory store).

# Gemini (document + referee agents)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PayPal Sandbox (escrow via Orders v2, intent AUTHORIZE)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_RETURN_URL=http://localhost:5173/paypal/return
PAYPAL_CANCEL_URL=http://localhost:5173/paypal/cancel
# Fixed demo rate: milestone INR amounts are charged in USD on PayPal sandbox.
INR_PER_USD=83

# Supabase (Postgres). Run supabase/schema.sql first. Use the service-role key (server only).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Optional explicit path to the tesseract binary, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
